!macro customHeader
    LangString appRunning ${LANG_UKRAINIAN} "${PRODUCT_NAME} зараз працює.$\r$\nНатисніть OK, і його буде закрито автоматично.$\r$\nЯкщо не вийде, закрийте його самі."
    LangString appRunning ${LANG_ENGLISH} "${PRODUCT_NAME} is running right now.$\r$\nClick OK and it will be closed automatically.$\r$\nIf that does not work, please close it yourself."
!macroend
