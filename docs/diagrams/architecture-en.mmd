flowchart LR
    subgraph ext[External services]
        api[alerts.in.ua]
        proxy[alert-proxy Worker]
        neptun[Neptun]
        deepstate[DeepState]
        kaggle[Kaggle]
        gh[GitHub Releases]
    end

    subgraph main[Electron main process]
        poller[alertPoller]
        notifier[notifier]
        regionStatus[regionAlertStatus]
        occupied[occupiedTerritoryStore]
        forecast[forecast services]
        watcher[forecastWatcher]
        weaponStats[weaponStatsStore]
        tray[tray]
        stores[regionsStore, settingsStore]
        updater[updater]
    end

    subgraph win[Renderer windows]
        settingsWin[Settings]
        forecastWin[Forecast]
        trendsWin[Trends]
        liveMapWin[Live map]
        popup[Tray popup]
        logWin[Log]
        aboutWin[About]
    end

    api --> proxy
    kaggle --> proxy
    proxy --> poller
    proxy --> forecast
    proxy --> weaponStats
    deepstate --> occupied
    neptun --> liveMapWin

    poller --> notifier
    poller --> regionStatus
    notifier --> tray

    forecast --> watcher
    watcher --> tray
    watcher --> popup

    regionStatus --> liveMapWin
    occupied --> liveMapWin
    weaponStats --> trendsWin

    stores --> settingsWin
    forecast --> forecastWin

    tray --> settingsWin
    tray --> forecastWin
    tray --> trendsWin
    tray --> liveMapWin
    tray --> logWin
    tray --> aboutWin
    tray --> popup

    updater --> gh

    classDef extNode fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef mainNode fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef winNode fill:#ede9fe,stroke:#7c3aed,color:#4c1d95

    class api,proxy,neptun,deepstate,kaggle,gh extNode
    class poller,notifier,regionStatus,occupied,forecast,watcher,weaponStats,tray,stores,updater mainNode
    class settingsWin,forecastWin,trendsWin,liveMapWin,popup,logWin,aboutWin winNode

    style ext fill:#eff6ff,stroke:#93c5fd
    style main fill:#f0fdf4,stroke:#86efac
    style win fill:#f5f3ff,stroke:#c4b5fd
