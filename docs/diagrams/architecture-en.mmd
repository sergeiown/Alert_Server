flowchart LR
    subgraph ext[External services]
        ukrainealarm[UkraineAlarm]
        api[alerts.in.ua]
        proxy[alert-proxy Worker]
        neptun[Neptun]
        deepstate[DeepState]
        kaggle[Kaggle]
        gh[GitHub Releases]
    end

    subgraph main[Electron main process]
        sourceManager[alertSourceManager]
        uaSource[ukraineAlarmSource]
        poller[alertPoller]
        altSource[neptunAlertsSource]
        threatsStore[neptunThreatsStore]
        activeData[(activeAlertData)]
        notifier[notifier]
        regionStatus[regionAlertStatus]
        todayStats[todayStatsStore]
        historyBackfill[historyBackfillStore]
        occupied[occupiedTerritoryStore]
        forecast[forecast services]
        watcher[forecastWatcher]
        weaponStats[weaponStatsStore]
        tray[tray]
        stores[regionsStore, settingsStore]
        updater[updater]
    end

    subgraph win[Renderer windows]
        settingsWin[Settings]
        forecastWin[Forecast]
        trendsWin[Trends]
        liveMapWin[Live map]
        popup[Tray popup]
        logWin[Log]
        aboutWin[About]
    end

    ukrainealarm --> proxy
    ukrainealarm -. webhook push .-> proxy
    api --> proxy
    kaggle --> proxy
    proxy -->|WebSocket push| uaSource
    proxy -->|WebSocket push| poller
    proxy --> forecast
    proxy --> weaponStats
    proxy --> todayStats
    proxy --> historyBackfill
    deepstate --> occupied
    neptun -->|WebSocket stream| threatsStore
    neptun --> altSource

    pushNote(["persistent connection, kept alive for the whole app session falls back to polling only while down"])
    proxy -. pushes via .-> pushNote
    pushNote -. explains .-> uaSource
    pushNote -. explains .-> poller
    pushNote -. explains .-> threatsStore

    levelNote(["alert_level / threats(red / yellow), all 3 sources"])
    proxy -. adds .-> levelNote
    altSource -. adds .-> levelNote

    stores -. preferred source .-> sourceManager
    sourceManager -. failover chain .-> uaSource
    sourceManager -. failover chain .-> poller
    sourceManager -. failover chain .-> altSource
    uaSource --> activeData
    poller --> activeData
    altSource --> activeData
    uaSource --> notifier
    poller --> notifier
    altSource --> notifier
    uaSource --> regionStatus
    poller --> regionStatus
    altSource --> regionStatus
    notifier --> tray

    activeData --> forecast
    activeData --> watcher
    historyBackfill --> forecast
    forecast --> watcher
    watcher --> tray
    watcher --> popup

    regionStatus --> liveMapWin
    threatsStore --> liveMapWin
    occupied --> liveMapWin
    weaponStats --> trendsWin
    todayStats --> trendsWin

    stores --> settingsWin
    forecast --> forecastWin

    tray --> settingsWin
    tray --> forecastWin
    tray --> trendsWin
    tray --> liveMapWin
    tray --> logWin
    tray --> aboutWin
    tray --> popup

    updater --> gh

    classDef extNode fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef mainNode fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef winNode fill:#ede9fe,stroke:#7c3aed,color:#4c1d95
    classDef noteNode fill:#fef9c3,stroke:#ca8a04,color:#713f12,stroke-dasharray:3 3

    class ukrainealarm,api,proxy,neptun,deepstate,kaggle,gh extNode
    class sourceManager,uaSource,poller,altSource,threatsStore,activeData,notifier,regionStatus,todayStats,historyBackfill,occupied,forecast,watcher,weaponStats,tray,stores,updater mainNode
    class settingsWin,forecastWin,trendsWin,liveMapWin,popup,logWin,aboutWin winNode
    class levelNote,pushNote noteNode

    style ext fill:#eff6ff,stroke:#93c5fd
    style main fill:#f0fdf4,stroke:#86efac
