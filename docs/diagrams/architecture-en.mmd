flowchart LR
    subgraph ext[External services]
        api[alerts.in.ua]
        neptun[Neptun]
        deepstate[DeepState]
        kaggle[Kaggle]
    end

    gh[GitHub Releases]

    subgraph srv[Alert Server backend]
        pollers[Source pollers and relays]
        archive[(Alert and threat archive)]
        forecastEngine[Forecast engine]
        trendsEngine[Today stats and daily peaks]
        threatAnalytics[Threat analytics]
        srvCache[Cached datasets]
        gateway[HTTPS and WebSocket API]
    end

    subgraph main[Electron main process]
        sourceManager[alertSourceManager]
        poller[alertPoller]
        altSource[neptunAlertsSource]
        threatsStore[neptunThreatsStore]
        activeData[(activeAlertData)]
        notifier[notifier]
        regionStatus[regionAlertStatus]
        todayStats[todayStatsStore]
        occupied[occupiedTerritoryStore]
        forecast[forecast client]
        watcher[forecastWatcher]
        weaponStats[weaponStatsStore]
        tray[tray]
        stores[regionsStore, settingsStore]
        updater[updater]
        connectivity[connectivityMonitor]
        threatTrends[threatTrendsStore]
    end

    subgraph win["Main window (tiles hub)"]
        hubShell[Hub shell: tiles and navigation]
        statusWin[Current status]
        settingsWin[Settings]
        forecastWin[Forecast]
        trendsWin[Trends]
        liveMapWin[Live map]
        logWin[Event log]
        aboutWin[About]
    end

    api -->|polled at the fastest pace its API allows| pollers
    neptun -->|WebSocket stream| pollers
    deepstate --> srvCache
    kaggle --> srvCache
    pollers --> archive
    archive --> forecastEngine
    archive --> trendsEngine
    archive --> threatAnalytics
    threatAnalytics --> gateway
    pollers --> gateway
    forecastEngine --> gateway
    trendsEngine --> gateway
    srvCache --> gateway

    gateway -->|WebSocket push, persistent connection, polling fallback only while it is down| poller
    gateway -->|WebSocket push| threatsStore
    gateway --> altSource
    gateway --> forecast
    gateway --> todayStats
    gateway --> weaponStats
    gateway --> threatTrends
    gateway --> occupied
    neptun -. direct fallback .-> threatsStore
    neptun -. direct fallback .-> altSource


    levelNote(["alert_level / threats (red / yellow) from every source"])
    pollers -. adds .-> levelNote

    stores -. preferred source .-> sourceManager
    sourceManager -. failover chain .-> poller
    sourceManager -. failover chain .-> altSource
    poller --> activeData
    altSource --> activeData
    poller --> notifier
    altSource --> notifier
    poller --> regionStatus
    altSource --> regionStatus
    notifier --> tray

    activeData --> watcher
    forecast --> watcher
    forecast --> statusWin
    watcher --> tray
    activeData --> statusWin

    regionStatus --> liveMapWin
    threatsStore --> liveMapWin
    occupied --> liveMapWin
    weaponStats --> trendsWin
    todayStats --> trendsWin
    threatTrends --> trendsWin

    stores --> settingsWin
    forecast --> forecastWin

    tray --> hubShell
    hubShell --> statusWin
    hubShell --> settingsWin
    hubShell --> forecastWin
    hubShell --> trendsWin
    hubShell --> liveMapWin
    hubShell --> logWin
    hubShell --> aboutWin
    connectivity -. sleep and network events .-> logWin

    updater --> gh

    classDef extNode fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef srvNode fill:#ffedd5,stroke:#ea580c,color:#7c2d12
    classDef mainNode fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef winNode fill:#ede9fe,stroke:#7c3aed,color:#4c1d95
    classDef noteNode fill:#fef9c3,stroke:#ca8a04,color:#713f12,stroke-dasharray:3 3

    class api,neptun,deepstate,kaggle,gh extNode
    class pollers,archive,forecastEngine,trendsEngine,threatAnalytics,srvCache,gateway srvNode
    class sourceManager,poller,altSource,threatsStore,activeData,notifier,regionStatus,todayStats,occupied,forecast,watcher,weaponStats,tray,stores,updater,connectivity,threatTrends mainNode
    class hubShell,statusWin,settingsWin,forecastWin,trendsWin,liveMapWin,logWin,aboutWin winNode
    class levelNote noteNode

    style ext fill:#eff6ff,stroke:#93c5fd
    style srv fill:#fff7ed,stroke:#fdba74
    style main fill:#f0fdf4,stroke:#86efac
    style win fill:#f5f3ff,stroke:#c4b5fd
