flowchart LR
    subgraph ext[Зовнішні сервіси]
        api[alerts.in.ua]
        neptun[Neptun]
        deepstate[DeepState]
        kaggle[Kaggle]
    end

    gh[GitHub Releases]

    subgraph srv[Серверна частина Alert Server]
        pollers[Опитувачі та ретранслятори джерел]
        archive[(Архів тривог і загроз)]
        forecastEngine[Рушій прогнозу]
        trendsEngine[Статистика дня та піки]
        threatAnalytics[Аналітика загроз]
        srvCache[Кешовані набори даних]
        gateway[HTTPS і WebSocket API]
    end

    subgraph main[Основний процес Electron]
        sourceManager[alertSourceManager]
        poller[alertPoller]
        altSource[neptunAlertsSource]
        threatsStore[neptunThreatsStore]
        activeData[(activeAlertData)]
        notifier[notifier]
        regionStatus[regionAlertStatus]
        todayStats[todayStatsStore]
        occupied[occupiedTerritoryStore]
        forecast[клієнт прогнозу]
        watcher[forecastWatcher]
        weaponStats[weaponStatsStore]
        tray[tray]
        stores[regionsStore, settingsStore]
        updater[updater]
        connectivity[connectivityMonitor]
        threatTrends[threatTrendsStore]
    end

    subgraph win["Головне вікно (хаб із плитками)"]
        hubShell[Оболонка хаба: плитки та навігація]
        statusWin[Поточний статус]
        settingsWin[Налаштування]
        forecastWin[Прогноз]
        trendsWin[Тенденції]
        liveMapWin[Жива мапа]
        logWin[Журнал]
        aboutWin[Про застосунок]
    end

    api -->|опитується з максимальною частотою, яку дозволяє його API| pollers
    neptun -->|потік WebSocket| pollers
    deepstate --> srvCache
    kaggle --> srvCache
    pollers --> archive
    archive --> forecastEngine
    archive --> trendsEngine
    archive --> threatAnalytics
    threatAnalytics --> gateway
    pollers --> gateway
    forecastEngine --> gateway
    trendsEngine --> gateway
    srvCache --> gateway

    gateway -->|WebSocket push, постійне з'єднання, опитування лише поки воно недоступне| poller
    gateway -->|WebSocket push| threatsStore
    gateway --> altSource
    gateway --> forecast
    gateway --> todayStats
    gateway --> weaponStats
    gateway --> threatTrends
    gateway --> occupied
    neptun -. пряме резервне підключення .-> threatsStore
    neptun -. пряме резервне підключення .-> altSource


    levelNote(["alert_level / threats (червоний / жовтий) з кожного джерела"])
    pollers -. додає .-> levelNote

    stores -. пріоритетне джерело .-> sourceManager
    sourceManager -. ланцюжок переключення .-> poller
    sourceManager -. ланцюжок переключення .-> altSource
    poller --> activeData
    altSource --> activeData
    poller --> notifier
    altSource --> notifier
    poller --> regionStatus
    altSource --> regionStatus
    notifier --> tray

    activeData --> watcher
    forecast --> watcher
    forecast --> statusWin
    watcher --> tray
    activeData --> statusWin

    regionStatus --> liveMapWin
    threatsStore --> liveMapWin
    occupied --> liveMapWin
    weaponStats --> trendsWin
    todayStats --> trendsWin
    threatTrends --> trendsWin

    stores --> settingsWin
    forecast --> forecastWin

    tray --> hubShell
    hubShell --> statusWin
    hubShell --> settingsWin
    hubShell --> forecastWin
    hubShell --> trendsWin
    hubShell --> liveMapWin
    hubShell --> logWin
    hubShell --> aboutWin
    connectivity -. події сну та мережі .-> logWin

    updater --> gh

